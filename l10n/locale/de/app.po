# German translations for the Archive Viewer.
# Draft translations by Claude (AI). Review by a native speaker welcome.
msgid ""
msgstr ""
"Project-Id-Version: archive-viewer\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Loading archive"
msgstr "Archiv wird geladen"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Open again"
msgstr "Erneut öffnen"

msgid "Download archive"
msgstr "Archiv herunterladen"

msgid "Preparing the archive on the server… %{percent}%"
msgstr "Archiv wird auf dem Server vorbereitet… %{percent}%"

msgid "Reading the archive on the server… %{percent}%"
msgstr "Archiv wird auf dem Server gelesen… %{percent}%"

msgid "Reading archive index…"
msgstr "Archivverzeichnis wird gelesen…"

msgid "Decompressing…"
msgstr "Wird entpackt…"

msgid "Downloading… %{percent}%"
msgstr "Wird heruntergeladen… %{percent}%"

msgid "Downloading… %{size}"
msgstr "Wird heruntergeladen… %{size}"

msgid "This archive format is not supported yet. You can download it instead."
msgstr ""
"Dieses Archivformat wird noch nicht unterstützt. Sie können es stattdessen "
"herunterladen."

msgid "The archive seems to be damaged or is not a valid archive."
msgstr "Das Archiv scheint beschädigt oder kein gültiges Archiv zu sein."

msgid ""
"Server busy: not enough space to open this archive right now. Try again in a "
"few minutes."
msgstr "Server ausgelastet: Im Moment ist nicht genug Platz, um dieses Archiv zu öffnen. Versuchen Sie es in ein paar Minuten erneut."

msgid "You have too many large archives open. Close one and try again."
msgstr "Sie haben zu viele große Archive geöffnet. Schließen Sie eines und versuchen Sie es erneut."

msgid ""
"This archive is larger than the server allows (%{limit}). You can download "
"it instead."
msgstr "Dieses Archiv ist größer, als der Server erlaubt (%{limit}). Sie können es stattdessen herunterladen."

msgid ""
"This archive is too large or complex to list on the server. You can download "
"it instead."
msgstr "Dieses Archiv ist zu groß oder zu komplex, um es auf dem Server aufzulisten. Sie können es stattdessen herunterladen."

msgid "The archive changed while it was being opened. Please try again."
msgstr "Das Archiv wurde während des Öffnens geändert. Bitte versuchen Sie es erneut."

msgid "The server could not open this archive. You can download it instead."
msgstr "Der Server konnte dieses Archiv nicht öffnen. Sie können es stattdessen herunterladen."

msgid ""
"This device does not have enough free memory to open this archive. You can "
"download it instead."
msgstr ""
"Dieses Gerät hat nicht genug freien Speicher, um dieses Archiv zu öffnen. "
"Sie können es stattdessen herunterladen."

msgid "The archive expands to more data than the browser is allowed to open."
msgstr "Das Archiv entpackt sich zu mehr Daten, als der Browser öffnen darf."

msgid "The archive could not be loaded."
msgstr "Das Archiv konnte nicht geladen werden."

msgid ""
"This archive is larger than %{limit}, the most this viewer opens in the "
"browser on this device. You can download it instead."
msgstr ""
"Dieses Archiv ist größer als %{limit} – mehr öffnet dieser Betrachter auf "
"diesem Gerät nicht im Browser. Sie können es stattdessen herunterladen."

msgid ""
"This archive was closed on the server after a period of inactivity. Reload "
"the page to open it again."
msgstr "Dieses Archiv wurde nach längerer Inaktivität auf dem Server geschlossen. Laden Sie die Seite neu, um es wieder zu öffnen."

msgid "Opening the archive was cancelled."
msgstr "Das Öffnen des Archivs wurde abgebrochen."

msgid "Search in archive"
msgstr "Im Archiv suchen"

msgid "Extracting"
msgstr "Wird entpackt"

msgid "Showing the first %{count} results"
msgstr "Die ersten %{count} Ergebnisse werden angezeigt"

msgid "%{count} result"
msgid_plural "%{count} results"
msgstr[0] "%{count} Ergebnis"
msgstr[1] "%{count} Ergebnisse"

msgid "Select all"
msgstr "Alle auswählen"

msgid "Actions"
msgstr "Aktionen"

msgid "Select %{name}"
msgstr "%{name} auswählen"

msgid "Preview %{name}"
msgstr "Vorschau von %{name}"

msgid "Download %{name}"
msgstr "%{name} herunterladen"

msgid "No matching files"
msgstr "Keine passenden Dateien"

msgid "This folder is empty"
msgstr "Dieser Ordner ist leer"

msgid "Loading"
msgstr "Wird geladen"

msgid "Show more (%{shown} of %{total})"
msgstr "Mehr anzeigen (%{shown} von %{total})"

msgid "Download %{size}?"
msgstr "%{size} herunterladen?"

msgid ""
"%{count} file, %{size} in total. Make sure your device has enough free space."
msgid_plural ""
"%{count} files, %{size} in total. Make sure your device has enough free "
"space."
msgstr[0] "%{count} Datei, insgesamt %{size}. Achten Sie darauf, dass Ihr Gerät genug freien Speicherplatz hat."
msgstr[1] "%{count} Dateien, insgesamt %{size}. Achten Sie darauf, dass Ihr Gerät genug freien Speicherplatz hat."

msgid "Download"
msgstr "Herunterladen"

msgid "Name"
msgstr "Name"

msgid "Size"
msgstr "Größe"

msgid "Modified"
msgstr "Geändert"

msgid "Failed to list the archive"
msgstr "Das Archiv konnte nicht aufgelistet werden"

msgid "Download selected (%{count})"
msgstr "Auswahl herunterladen (%{count})"

msgid "Download selected"
msgstr "Auswahl herunterladen"

msgid ""
"Files larger than %{limit} cannot be extracted in the browser on this "
"device. Download the whole archive instead."
msgstr ""
"Dateien über %{limit} können auf diesem Gerät nicht im Browser entpackt "
"werden. Laden Sie stattdessen das ganze Archiv herunter."

msgid ""
"This device does not have enough free memory to extract this. Download the "
"whole archive instead."
msgstr ""
"Dieses Gerät hat nicht genug freien Speicher, um dies zu entpacken. Laden "
"Sie stattdessen das ganze Archiv herunter."

msgid "This download is too large (%{size}, limit %{limit})."
msgstr "Dieser Download ist zu groß (%{size}, Grenze %{limit})."

msgid ""
"You already have %{count} downloads running. Wait for one to finish and try "
"again."
msgstr "Es laufen bereits %{count} Downloads. Warten Sie, bis einer fertig ist, und versuchen Sie es erneut."

msgid ""
"This archive was closed on the server. Reload the page to open it again."
msgstr "Dieses Archiv wurde auf dem Server geschlossen. Laden Sie die Seite neu, um es wieder zu öffnen."

msgid "The selection contains no files that can be downloaded."
msgstr "Die Auswahl enthält keine Dateien, die heruntergeladen werden können."

msgid "The server could not complete this. Please try again."
msgstr "Der Server konnte das nicht abschließen. Bitte versuchen Sie es erneut."

msgid "Extracting %{name}…"
msgstr "%{name} wird entpackt…"

msgid "Extracting %{name}… %{percent}%"
msgstr "%{name} wird entpackt… %{percent}%"

msgid "Failed to download \"%{name}\""
msgstr "„%{name}“ konnte nicht heruntergeladen werden"

msgid "Failed to download the selection"
msgstr "Die Auswahl konnte nicht heruntergeladen werden"

msgid "Loading preview"
msgstr "Vorschau wird geladen"

msgid "Only the beginning of the file is shown."
msgstr "Nur der Anfang der Datei wird angezeigt."

msgid "Close"
msgstr "Schließen"

msgid "This file is password protected and cannot be previewed."
msgstr ""
"Diese Datei ist passwortgeschützt und kann nicht in der Vorschau angezeigt "
"werden."

msgid "This file cannot be read."
msgstr "Diese Datei kann nicht gelesen werden."

msgid "No preview available for this file type."
msgstr "Für diesen Dateityp ist keine Vorschau verfügbar."

msgid "This file is too large to preview. Download it instead."
msgstr ""
"Diese Datei ist zu groß für eine Vorschau. Laden Sie sie stattdessen "
"herunter."

msgid "The preview could not be loaded."
msgstr "Die Vorschau konnte nicht geladen werden."

msgid "This image could not be displayed. Download it instead."
msgstr ""
"Dieses Bild konnte nicht angezeigt werden. Laden Sie es stattdessen herunter."

msgid "Archive Viewer"
msgstr "Archiv-Betrachter"
