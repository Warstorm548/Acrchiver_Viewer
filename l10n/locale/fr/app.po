# French translations for the Archive Viewer.
# Draft translations by Claude (AI). Review by a native speaker welcome.
msgid ""
msgstr ""
"Project-Id-Version: archive-viewer\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Loading archive"
msgstr "Chargement de l'archive"

msgid "Cancel"
msgstr "Annuler"

msgid "Open again"
msgstr "Ouvrir à nouveau"

msgid "Download archive"
msgstr "Télécharger l'archive"

msgid "Preparing the archive on the server… %{percent}%"
msgstr "Préparation de l'archive sur le serveur… %{percent} %"

msgid "Reading the archive on the server… %{percent}%"
msgstr "Lecture de l'archive sur le serveur… %{percent} %"

msgid "Reading archive index…"
msgstr "Lecture de l'index de l'archive…"

msgid "Decompressing…"
msgstr "Décompression…"

msgid "Downloading… %{percent}%"
msgstr "Téléchargement… %{percent} %"

msgid "Downloading… %{size}"
msgstr "Téléchargement… %{size}"

msgid "This archive format is not supported yet. You can download it instead."
msgstr ""
"Ce format d'archive n'est pas encore pris en charge. Vous pouvez la "
"télécharger à la place."

msgid "The archive seems to be damaged or is not a valid archive."
msgstr "L'archive semble endommagée ou n'est pas une archive valide."

msgid ""
"Server busy: not enough space to open this archive right now. Try again in a "
"few minutes."
msgstr ""
"Serveur occupé : pas assez d'espace pour ouvrir cette archive pour le "
"moment. Réessayez dans quelques minutes."

msgid "You have too many large archives open. Close one and try again."
msgstr ""
"Vous avez trop de grandes archives ouvertes. Fermez-en une et réessayez."

msgid ""
"This archive is larger than the server allows (%{limit}). You can download "
"it instead."
msgstr ""
"Cette archive dépasse la taille autorisée par le serveur (%{limit}). Vous "
"pouvez la télécharger à la place."

msgid ""
"This archive is too large or complex to list on the server. You can download "
"it instead."
msgstr ""
"Cette archive est trop volumineuse ou trop complexe pour être listée sur le "
"serveur. Vous pouvez la télécharger à la place."

msgid ""
"This archive is password-protected, which is not supported. You can download "
"it instead."
msgstr ""
"Cette archive est protégée par un mot de passe, ce qui n'est pas pris en "
"charge. Vous pouvez la télécharger à la place."

msgid "The archive changed while it was being opened. Please try again."
msgstr "L'archive a été modifiée pendant son ouverture. Veuillez réessayer."

msgid "The server could not open this archive. You can download it instead."
msgstr ""
"Le serveur n'a pas pu ouvrir cette archive. Vous pouvez la télécharger à la "
"place."

msgid ""
"This device does not have enough free memory to open this archive. You can "
"download it instead."
msgstr ""
"Cet appareil n'a pas assez de mémoire libre pour ouvrir cette archive. Vous "
"pouvez la télécharger à la place."

msgid "The archive expands to more data than the browser is allowed to open."
msgstr ""
"L'archive se décompresse en plus de données que le navigateur n'est autorisé "
"à ouvrir."

msgid "The archive could not be loaded."
msgstr "L'archive n'a pas pu être chargée."

msgid ""
"This archive is larger than %{limit}, the most this viewer opens in the "
"browser on this device. You can download it instead."
msgstr ""
"Cette archive dépasse %{limit}, le maximum que cette visionneuse ouvre dans "
"le navigateur sur cet appareil. Vous pouvez la télécharger à la place."

msgid ""
"This archive was closed on the server after a period of inactivity. Reload "
"the page to open it again."
msgstr ""
"Cette archive a été fermée sur le serveur après une période d'inactivité. "
"Rechargez la page pour l'ouvrir à nouveau."

msgid "Opening the archive was cancelled."
msgstr "L'ouverture de l'archive a été annulée."

msgid ""
"The server could not prepare this archive, so it is read in the browser, "
"where some files may not open."
msgstr ""
"Le serveur n'a pas pu préparer cette archive : elle est donc lue dans le "
"navigateur, où certains fichiers risquent de ne pas s'ouvrir."

msgid ""
"This archive format can only be opened when the server helper is installed. "
"You can download it instead."
msgstr ""
"Ce format d'archive ne peut être ouvert que si l'assistant serveur est "
"installé. Vous pouvez la télécharger à la place."

msgid "Search in archive"
msgstr "Rechercher dans l'archive"

msgid "Extracting"
msgstr "Extraction"

msgid "Showing the first %{count} results"
msgstr "Affichage des %{count} premiers résultats"

msgid "%{count} result"
msgid_plural "%{count} results"
msgstr[0] "%{count} résultat"
msgstr[1] "%{count} résultats"

msgid "Select all"
msgstr "Tout sélectionner"

msgid "Actions"
msgstr "Actions"

msgid "Select %{name}"
msgstr "Sélectionner %{name}"

msgid "Preview %{name}"
msgstr "Aperçu de %{name}"

msgid "Download %{name}"
msgstr "Télécharger %{name}"

msgid "No matching files"
msgstr "Aucun fichier correspondant"

msgid "This folder is empty"
msgstr "Ce dossier est vide"

msgid "Loading"
msgstr "Chargement"

msgid "Show more (%{shown} of %{total})"
msgstr "Afficher plus (%{shown} sur %{total})"

msgid "Download %{size}?"
msgstr "Télécharger %{size} ?"

msgid ""
"%{count} file, %{size} in total. Make sure your device has enough free space."
msgid_plural ""
"%{count} files, %{size} in total. Make sure your device has enough free "
"space."
msgstr[0] ""
"%{count} fichier, %{size} au total. Vérifiez que votre appareil dispose de "
"suffisamment d’espace libre."
msgstr[1] ""
"%{count} fichiers, %{size} au total. Vérifiez que votre appareil dispose de "
"suffisamment d’espace libre."

msgid "Download"
msgstr "Télécharger"

msgid "Name"
msgstr "Nom"

msgid "Size"
msgstr "Taille"

msgid "Modified"
msgstr "Modifié"

msgid "Failed to list the archive"
msgstr "Impossible de lister l'archive"

msgid "Download selected (%{count})"
msgstr "Télécharger la sélection (%{count})"

msgid "Download selected"
msgstr "Télécharger la sélection"

msgid ""
"Files larger than %{limit} cannot be extracted in the browser on this "
"device. Download the whole archive instead."
msgstr ""
"Les fichiers de plus de %{limit} ne peuvent pas être extraits dans le "
"navigateur sur cet appareil. Téléchargez plutôt l'archive complète."

msgid ""
"This device does not have enough free memory to extract this. Download the "
"whole archive instead."
msgstr ""
"Cet appareil n'a pas assez de mémoire libre pour extraire ceci. Téléchargez "
"plutôt l'archive complète."

msgid "This download is too large (%{size}, limit %{limit})."
msgstr "Ce téléchargement est trop volumineux (%{size}, limite %{limit})."

msgid ""
"You already have %{count} downloads running. Wait for one to finish and try "
"again."
msgstr ""
"Vous avez déjà %{count} téléchargements en cours. Attendez que l'un d'eux se "
"termine, puis réessayez."

msgid ""
"This archive was closed on the server. Reload the page to open it again."
msgstr ""
"Cette archive a été fermée sur le serveur. Rechargez la page pour l'ouvrir à "
"nouveau."

msgid "The selection contains no files that can be downloaded."
msgstr "La sélection ne contient aucun fichier téléchargeable."

msgid "The server could not complete this. Please try again."
msgstr "Le serveur n'a pas pu terminer cette action. Veuillez réessayer."

msgid "Extracting %{name}…"
msgstr "Extraction de %{name}…"

msgid "Extracting %{name}… %{percent}%"
msgstr "Extraction de %{name}… %{percent} %"

msgid "Failed to download \"%{name}\""
msgstr "Impossible de télécharger « %{name} »"

msgid "Failed to download the selection"
msgstr "Impossible de télécharger la sélection"

msgid "Loading preview"
msgstr "Chargement de l'aperçu"

msgid "Only the beginning of the file is shown."
msgstr "Seul le début du fichier est affiché."

msgid "Close"
msgstr "Fermer"

msgid "This file is password protected and cannot be previewed."
msgstr ""
"Ce fichier est protégé par un mot de passe et ne peut pas être prévisualisé."

msgid "This file cannot be read."
msgstr "Ce fichier ne peut pas être lu."

msgid "No preview available for this file type."
msgstr "Aucun aperçu disponible pour ce type de fichier."

msgid "This file is too large to preview. Download it instead."
msgstr "Ce fichier est trop volumineux pour un aperçu. Téléchargez-le plutôt."

msgid "The preview could not be loaded."
msgstr "L'aperçu n'a pas pu être chargé."

msgid "This image could not be displayed. Download it instead."
msgstr "Cette image n'a pas pu être affichée. Téléchargez-la plutôt."

msgid "Archive Viewer"
msgstr "Visionneuse d'archives"
