{
  "name": "web-app-archive-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCloud Web archive viewer - browse and preview archive contents",
  "type": "module",
  "keywords": [
    "opencloud",
    "archive",
    "zip",
    "tar",
    "7z",
    "rar",
    "viewer"
  ],
  "author": "Warstorm548",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Warstorm548/Acrchiver_Viewer.git"
  },
  "bugs": "https://github.com/Warstorm548/Acrchiver_Viewer/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^8.1.0",
    "@opencloud-eu/extension-sdk": "^8.1.0",
    "@opencloud-eu/prettier-config": "^8.1.0",
    "@opencloud-eu/tsconfig": "^8.1.0",
    "@opencloud-eu/web-client": "^8.1.0",
    "@opencloud-eu/web-pkg": "^8.1.0",
    "@opencloud-eu/web-test-helpers": "^8.1.0",
    "@types/node": "^24.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.1.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "^5.0.0",
    "vue": "^3.5.10",
    "vue-tsc": "^3.2.6",
    "vue3-gettext": "4.0.1"
  },
  "packageManager": "pnpm@11.28.8"
}
