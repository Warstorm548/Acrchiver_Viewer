{
  "name": "Archive Viewer",
  "id": "archive-viewer",
  "version": "1.0.0",
  "description": "View and extract multiple archive formats (ZIP, TAR, 7Z, RAR, etc.) directly in OpenCloud",
  "category": "Productivity",
  "icon": "file-zip",
  "author": "OpenCloud Contributors",
  "license": "Apache-2.0",
  "repository": "https://github.com/opencloud-eu/web-app-archive-viewer",
  "entrypoint": "index.js",
  "supportedFormats": [
    "zip",
    "tar",
    "gz",
    "tgz",
    "bz2",
    "7z",
    "rar",
    "xz"
  ],
  "mimeTypes": [
    "application/zip",
    "application/x-zip-compressed",
    "application/x-tar",
    "application/x-gtar",
    "application/x-gzip",
    "application/gzip",
    "application/x-bzip2",
    "application/x-7z-compressed",
    "application/x-rar-compressed",
    "application/vnd.rar",
    "application/x-xz"
  ],
  "features": [
    "Browse archives without full extraction",
    "Preview text and image files",
    "Download individual or multiple files",
    "Search within archives",
    "Memory-efficient processing",
    "Support for encrypted archives",
    "Batch operations"
  ],
  "permissions": [
    "files.read",
    "files.download"
  ],
  "minVersion": "1.0.0",
  "screenshots": []
}
