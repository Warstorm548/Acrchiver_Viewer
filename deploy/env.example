## Archive Viewer helper (custom/archive-helper.yml). Copy the lines you want to change into
## opencloud-compose's .env; every value shown is the default. Sizes take GB/TB (decimal, like
## disks are sold) or GiB/TiB; durations take m/h. Restart the helper after a change:
##   sudo docker compose up -d archive-helper
## Limits apply to every user alike, admins included. Changing .env is the only way to change them.

## Temp folder on the host, relative to the opencloud-compose folder. Keep the leading ./ so it
## never points at the root of the system. Create it before the first start and give it to the
## helper's user:  mkdir ./archive-temp && sudo chown 1500:1500 ./archive-temp
#ARCHIVE_HELPER_TEMP_DIR=./archive-temp

## The helper's own user ID (shared with no other container). To change it later: edit this,
## run  sudo chown -R <new id> ./archive-temp, then  sudo docker compose up -d archive-helper
#ARCHIVE_HELPER_UID_GID=1500:1500

## Total temp space for all users together. Any value is allowed (also above 100GB), but the
## disk must have it: Docker can't limit a folder's size, the helper enforces this itself.
#ARCHIVE_HELPER_MAX_STORAGE=50GB
## The most one user's open archives may use at once.
#ARCHIVE_HELPER_MAX_STORAGE_PER_USER=25GB

## Downloads out of an archive: largest single file, largest multi-file ZIP, size above which the
## viewer asks "Download X GB?", and downloads one user may run at once.
#ARCHIVE_HELPER_MAX_DOWNLOAD_SIZE=10GB
#ARCHIVE_HELPER_MAX_SELECTION_SIZE=10GB
#ARCHIVE_HELPER_CONFIRM_DOWNLOAD_SIZE=1GB
#ARCHIVE_HELPER_MAX_DOWNLOADS_PER_USER=3

## An open archive is deleted this long after the viewer stops reporting (tab closed, crash).
#ARCHIVE_HELPER_SESSION_TIMEOUT=10m

## Parser limits against archives built to exhaust the server: entries listed, data
## decompressed while listing, and time spent listing.
#ARCHIVE_HELPER_MAX_ENTRIES=500000
#ARCHIVE_HELPER_MAX_SCAN_SIZE=500GB
#ARCHIVE_HELPER_SCAN_TIMEOUT=60m

## Container resources (GOMEMLIMIT should stay about 10 % below the memory limit).
#ARCHIVE_HELPER_MEMORY_LIMIT=2g
#ARCHIVE_HELPER_GOMEMLIMIT=1800MiB
#ARCHIVE_HELPER_CPUS=2

## Where the helper's source is built from, and the image tag.
#ARCHIVE_HELPER_BUILD_DIR=../Acrchiver_Viewer/server
#ARCHIVE_HELPER_TAG=0.4.0
